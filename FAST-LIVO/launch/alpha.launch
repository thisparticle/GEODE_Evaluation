<launch>
<!-- Launch file for Livox AVIA LiDAR -->

	<arg name="rviz" default="true" />

	<!-- <arg name="bag_name" value="/media/chunran/Chunran/rosbag/mtr/xu2_new.bag"/> -->

	<!-- <node pkg="rosbag" type="play" name="rosbag" args="-r 1.0 -s 0.0 $(arg bag_name)"/> -->

	<rosparam command="load" file="$(find fast_livo)/config/alpha_indoor.yaml" />

	<node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen" >
		<rosparam file="$(find fast_livo)/config/camera_alpha.yaml" />
	</node>
	
	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/loam_livox.rviz" />
	</group>
	<node pkg="image_transport" type="republish" name="republish" args="compressed in:=/left_camera raw out:=/left_camera" output="screen" respawn="true"/>

	<arg name="bag_file_use" default="true" />
    <arg name="bag_file" default="/media/bowen/Data3/GEODE/sensor_data/Metro_tunnel/Tunneling_tunnel3_alpha/Tunneling_tunnel3_alpha.bag" />
	<param name="use_sim_time" value="true" />
    <group if="$(arg bag_file_use)">
        <node pkg="rosbag" type="play" name="rosbag" 
            args="--clock -r 1 $(arg bag_file)" required="true"/>    
    </group> 

launch-prefix="gdb -ex run --args" launch-prefix="valgrind --leak-check=full --show-leak-kinds=all"

</launch> 	
